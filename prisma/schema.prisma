generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Resume {
  id         String   @id @default(cuid())
  userEmail  String
  title      String
  name       String
  phone      String
  address    String
  themeColor String
  summary    String
  experience Json
  skills     Json
  education  Json
  email      String
  created_at DateTime @default(now())
}
